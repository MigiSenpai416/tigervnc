## Default settings for VNC servers started by the vncserver service
#
# Any settings given here will override the builtin defaults, but can
# also be overriden by ~/.config/tigervnc/config and vncserver-config-mandatory.
#
# See HOWTO.md and the following manpages for more details:
#     vncsession(8) Xvnc(1)
#
# Several common settings are shown below. Uncomment and modify to your
# liking.

# "mode" is either x11 (the default) or wayland. In Wayland mode, "session"
# names a file in /usr/share/wayland-sessions instead of /usr/share/xsessions.
# session=gnome
# mode=x11
# securitytypes=vncauth,tlsvnc
# geometry=2000x1200
# localhost
# alwaysshared
