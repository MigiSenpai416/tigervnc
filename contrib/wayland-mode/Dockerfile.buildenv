# Build + test environment for the TigerVNC fork with Wayland mode.
# Base: Ubuntu 26.04 (resolute). All key versions are pinned via ARGs below;
# bump them together and rebuild.
ARG BASE_IMAGE=ubuntu:26.04
FROM ${BASE_IMAGE}

# Pinned versions (Ubuntu 26.04 archive versions at time of writing)
ARG WLROOTS_PKG=libwlroots-0.19-dev
ARG WLROOTS_VERSION=0.19.2-1
ARG XORG_SOURCE_VERSION=2:21.1.22-1ubuntu1.3
ARG XWAYLAND_VERSION=2:24.1.10-1

ARG http_proxy
ARG https_proxy
ENV DEBIAN_FRONTEND=noninteractive

RUN if [ -n "$http_proxy" ]; then \
      printf 'Acquire::http::Proxy "%s";\nAcquire::https::Proxy "%s";\n' "$http_proxy" "${https_proxy:-$http_proxy}" > /etc/apt/apt.conf.d/80proxy; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential cmake pkg-config gettext ca-certificates git patch \
      autoconf automake libtool dh-autoreconf quilt bison flex \
      zlib1g-dev libjpeg-turbo8-dev libavcodec-dev libavutil-dev libswscale-dev \
      libpulse-dev libgnutls28-dev nettle-dev libgmp-dev libpam0g-dev libpng-dev \
      libxrandr-dev libxdamage-dev libfltk1.3-dev \
      "xorg-server-source=${XORG_SOURCE_VERSION}" "xserver-xorg-dev=${XORG_SOURCE_VERSION}" \
      uuid-dev libglib2.0-dev libpipewire-0.3-dev libwayland-dev libxkbcommon-dev \
      libpwquality-dev xutils-dev xfonts-utils x11proto-dev xtrans-dev libxau-dev \
      libxcvt-dev libxdmcp-dev libxfont-dev libxkbfile-dev libpixman-1-dev \
      libpciaccess-dev libgcrypt20-dev libudev-dev libselinux1-dev libaudit-dev \
      libdrm-dev libgl1-mesa-dev mesa-common-dev libunwind-dev libxmuu-dev \
      libxext-dev libx11-dev libxrender-dev libxi-dev libxpm-dev libxaw7-dev \
      libxt-dev libxmu-dev libxtst-dev libxres-dev libxfixes-dev libxv-dev \
      libxinerama-dev libxshmfence-dev libepoxy-dev libegl1-mesa-dev libgbm-dev \
      xkb-data x11-xkb-utils libbsd-dev libdbus-1-dev libsystemd-dev \
      "${WLROOTS_PKG}=${WLROOTS_VERSION}" "libwlroots-0.19=${WLROOTS_VERSION}" \
      wayland-protocols libxcb1-dev libxcb-xfixes0-dev libxcb-composite0-dev \
      libxcb-icccm4-dev libxcb-res0-dev libxcb-ewmh-dev \
      "xwayland=${XWAYLAND_VERSION}" \
      # runtime + test tooling
      xauth xinit x11-common x11-xserver-utils xterm x11-apps xdotool \
      foot wl-clipboard weston fonts-dejavu-core xfonts-base \
      python3 perl dbus dbus-x11 sudo procps psmisc libpam-modules \
      strace gdb less && \
    rm -rf /var/lib/apt/lists/*

# Window switcher extras of the Wayland mode: FreeType (distro) and
# lunasvg, which the distro does not package: built from its pinned
# upstream release (static, with the plutovg it bundles) into /usr/local
ARG LUNASVG_VERSION=3.5.0
ARG LUNASVG_SHA256=1abf1472ee6c4d19797916e8cc3c2e4b628e0d81178ffac60bdb0d457e32c690
RUN if [ -n "$http_proxy" ]; then \
      printf 'Acquire::http::Proxy "%s";\nAcquire::https::Proxy "%s";\n' "$http_proxy" "${https_proxy:-$http_proxy}" > /etc/apt/apt.conf.d/80proxy; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends libfreetype-dev curl && \
    rm -rf /var/lib/apt/lists/* && \
    cd /tmp && \
    curl -fsSL -o lunasvg.tar.gz \
      "https://github.com/sammycage/lunasvg/archive/refs/tags/v${LUNASVG_VERSION}.tar.gz" && \
    echo "${LUNASVG_SHA256}  lunasvg.tar.gz" | sha256sum -c - && \
    mkdir lunasvg && tar -xzf lunasvg.tar.gz -C lunasvg --strip-components=1 && \
    cmake -S lunasvg -B lunasvg-build -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
      -DUSE_SYSTEM_PLUTOVG=OFF -DLUNASVG_BUILD_EXAMPLES=OFF \
      -DLUNASVG_DISABLE_LOAD_SYSTEM_FONTS=ON -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build lunasvg-build -j"$(nproc)" && cmake --install lunasvg-build && \
    rm -rf /tmp/lunasvg* /etc/apt/apt.conf.d/80proxy
